# Supabase — your own project (https://supabase.com/dashboard → Project Settings → API)
# These are publishable values: safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Used by `pnpm typegen` to regenerate supabase/types.ts against your schema.
SUPABASE_PROJECT_REF=<your-project-ref>

# Amplify Function (Phase 3+) — set after deploy
# COMPILE_FUNCTION_URL=
