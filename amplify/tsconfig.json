{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "$amplify/*": ["./.amplify/generated/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", ".amplify"]
}
